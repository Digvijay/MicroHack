# Template for .env (in this folder). Do not fill it by hand: run
#   bash create-env.sh      (Codespace, Linux, macOS, Git Bash)
#   ./create-env.ps1        (Windows PowerShell)
# It reads your lab and writes .env. Never commit .env: it holds your Work IQ keys.

# Azure
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_RESOURCE_GROUP=

# Foundry: one resource, two projects
FOUNDRY_ACCOUNT=iq-<hash>
PROJECT_ENDPOINT_STRANDVIK=https://<account>.services.ai.azure.com/api/projects/strandvik
PROJECT_ENDPOINT_KOLVO=https://<account>.services.ai.azure.com/api/projects/kolvo
MODEL_DEPLOYMENT_NAME=gpt-5.4-mini
JUDGE_MODEL_DEPLOYMENT_NAME=gpt-5.6-luna
EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-large

# Foundry IQ (Azure AI Search) and the document store
SEARCH_ENDPOINT=https://<search>.search.windows.net
STORAGE_ACCOUNT=
DOCUMENTS_CONTAINER=documents

# Tracing
APPINSIGHTS_NAME=

# Fabric IQ
FABRIC_CAPACITY_NAME=
FABRIC_WORKSPACE_ID=

# Work IQ (the emulator in this lab; same MCP contract as Microsoft 365 Work IQ)
WORKIQ_MCP_URL=https://<function-app>.azurewebsites.net/mcp
WORKIQ_VIEWER_URL=https://<function-app>.azurewebsites.net/viewer
WORKIQ_BOARD_URL=https://<function-app>.azurewebsites.net/board
# Alex's persona key: for Alex's agent (MCP tool header) and the viewer
WORKIQ_KEY=
# Sam's persona key: for whoever plays Sam in the viewer
WORKIQ_KEY_SAM=