# Copy of your lab dashboard values. post-create.sh copies this file to src/.env.
# Never commit src/.env: it holds your Work IQ keys.

# Azure (from the dashboard: Subscription ID, Resource Group Name)
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=

# Foundry
PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
MODEL_DEPLOYMENT_NAME=gpt-5.4-mini
GRAPH_MODEL_DEPLOYMENT_NAME=gpt-5.6-luna
EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-small

# Foundry IQ (Azure AI Search) and the document store
SEARCH_ENDPOINT=https://<search>.search.windows.net
STORAGE_ACCOUNT_NAME=
STORAGE_CONTAINER=caldova-docs

# Fabric IQ
FABRIC_CAPACITY_NAME=
FABRIC_WORKSPACE_NAME=caldova-iq

# Work IQ (the emulator in this lab; same MCP contract as Microsoft 365 Work IQ)
WORKIQ_ENDPOINT=https://<function-app>.azurewebsites.net/mcp
WORKIQ_KEY_SALES_LEAD=
WORKIQ_KEY_SUPPLY_PLANNER=
WORKIQ_KEY_QUALITY_HEAD=
WORKIQ_KEY_PLANT_MANAGER=
