{
  // Microsoft IQ hack (Caldova): GitHub Codespaces / VS Code Dev Containers.
  // Python + uv + Azure CLI. post-create.sh installs dependencies and seeds src/.env.
  "name": "Azure / AI / Microsoft IQ",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bookworm",

  "features": {
    "ghcr.io/devcontainers/features/azure-cli:1": { "version": "latest" },
    "ghcr.io/devcontainers/features/github-cli:1": { "version": "latest" }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-azuretools.vscode-azureresourcegroups",
        "ms-windows-ai-studio.windows-ai-studio",
        "GitHub.copilot",
        "GitHub.copilot-chat"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/src/.venv/bin/python",
        "python.terminal.activateEnvironment": true,
        "python.analysis.include": ["src"],
        "python.analysis.exclude": ["**/.venv", "**/__pycache__", "**/.*"],
        // Hide facilitator and container folders from attendees (container only).
        "files.exclude": {
          "**/.git": true,
          "**/.DS_Store": true,
          "**/Thumbs.db": true,
          "labautomation": true,
          "walkthrough": false,
          ".devcontainer": true,
          "techtalk": true
        },
        "workbench.editorAssociations": { "*.md": "vscode.markdown.preview.editor" }
      }
    }
  },

  // Runs once after the container is created, from workspaceFolder (the hack folder).
  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "remoteUser": "vscode",

  // Keep the Python venv on a container volume (avoids file-sharing errors on Docker Desktop).
  "mounts": [
    "source=microsoft-iq-venv-${devcontainerId},target=/workspaces/${localWorkspaceFolderBasename}/03-Azure/01-04-AI/15_Microsoft_IQ/src/.venv,type=volume"
  ],

  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/03-Azure/01-04-AI/15_Microsoft_IQ",

  "remoteEnv": {
    "hackFolder": "/workspaces/${localWorkspaceFolderBasename}/03-Azure/01-04-AI/15_Microsoft_IQ",
    "PYTHONIOENCODING": "utf-8"
  }
}
